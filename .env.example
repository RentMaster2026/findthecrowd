# Virelo environment
#
# The app runs fully without these — it falls back to the local seed dataset so
# you can `npm run dev` immediately. Fill these in to switch to a live Supabase
# database with persistent, multi-user crowd reports.
#
# Get them from: Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only, used by scripts/seed.ts. Never expose this
# to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
